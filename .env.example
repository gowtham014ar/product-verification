# ────────────────────────────────────────────────────────────────
# Product Verification — Environment Configuration
# Copy this to .env and fill in real values before running.
# NEVER commit .env to git.
# ────────────────────────────────────────────────────────────────

# ── JWT ──────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-64-char-secret

# ── Blockchain — Sepolia Testnet ─────────────────────────────────
# Get a free RPC key at https://infura.io or https://alchemy.com
ETH_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Deployed contract address (from Remix or Foundry deploy)
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Contract owner public wallet address (optional reference/fallback)
CONTRACT_OWNER=0x0000000000000000000000000000000000000000

# Owner wallet private key — MetaMask → Account → Export Private Key
# Sepolia ETH from faucet: https://sepoliafaucet.com
OWNER_PRIVATE_KEY=0xYOUR_METAMASK_PRIVATE_KEY_HERE

# Chain ID: 11155111=Sepolia  1=Mainnet  31337=Anvil(local)
CHAIN_ID=11155111

# ── Local dev: Anvil ─────────────────────────────────────────────
# Uncomment to use local Anvil instead of Sepolia:
# ETH_RPC_URL=http://anvil:8545
# CHAIN_ID=31337
# Local Anvil account 0. This private key is public. Never use it on Sepolia or mainnet.
# OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
