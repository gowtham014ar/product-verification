{
  "info": {
    "_postman_id": "c62a8492-938b-4a57-b2bf-090c883e3901",
    "name": "Product Verification System - End-to-End & Health Suite",
    "description": "Comprehensive Postman test collection for Product Verification System microservices.\nIncludes service connectivity health checks, active/inactive service status tests, JWT authentication, 2-step product registration, on-chain hash storage, and zero-gas public verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
